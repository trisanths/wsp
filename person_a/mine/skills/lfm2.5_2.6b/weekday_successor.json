 "generator_code": "import random, json\nrandom.seed(0)\nD='Monday Tuesday Wednesday Thursday Friday Saturday Sunday'.split()\nitems=[];control=[]\nfor t in range(120):\n    k=random.choice([1,1,2,3])\n    shots=[]\n    for s in range(3):\n        a=random.randrange(7); shots.append(f\"{D[a]} + {k} -> {D[(a+k)%7]}\")\n    a=random.randrange(7)\n    items.append({\"prompt\":\"\\n\".join(shots)+f\"\\n{D[a]} + {k} ->\",\"answer\":\" \"+D[(a+k)%7]})\n    shots=[]\n    for s in range(3):\n        a=random.randrange(1,60); shots.append(f\"{a} + {k} -> {a+k}\")\n    a=random.randrange(1,60)\n    control.append({\"prompt\":\"\\n\".join(shots)+f\"\\n{a} + {k} ->\",\"answer\":\" \"+str(a+k)})\njson.dump({\"items\":items,\"control\":control},open('/work/skill.json','w'))",
