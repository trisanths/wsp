 "name": "weekday_successor",
 "description": "Continue a weekday sequence (e.g. 'Monday, Tuesday,' -> ' Wednesday'), wrapping Sunday->Monday. Control: same format with digit sequences.",
 "hash": "96b4aa2a8bf28253",
 "agent_items": false,
 "generator_code": "import random, json\nrandom.seed(0)\nD=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']\nprefixes=['','Days: ','Schedule: ','Week: ','Next: ','Order: ']\nitems=[];ctrl=[]\nfor p in prefixes:\n    for L in [2,3]:\n        for s in range(7):\n            seq=[D[(s+k)%7] for k in range(L)]; ans=D[(s+L)%7]\n            ds=random.randint(1,40)\n            items.append((p+', '.join(seq)+',', ' '+ans)); ctrl.append((p+', '.join(str(ds+k) for k in range(L))+',', ' '+str(ds+L)))\nrandom.shuffle(items); random.shuffle(ctrl)\njson.dump({'items':[{'prompt':a,'answer':b} for a,b in items],'control':[{'prompt':a,'answer':b} for a,b in ctrl]},open('/work/skill.json','w'))",
