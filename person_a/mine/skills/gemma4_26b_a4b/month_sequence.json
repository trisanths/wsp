 "generator_code": "import random, json\nrandom.seed(0)\nM=[\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"]\nitems=[];control=[]\nfor n in (2,3,4):\n    for i in range(12):\n        for step in (1,):\n            seq=[M[(i+j)%12] for j in range(n)]\n            items.append({\"prompt\":\", \".join(seq)+\",\",\"answer\":\" \"+M[(i+n)%12]})\n            control.append({\"prompt\":\", \".join(str(i+1+j) for j in range(n))+\",\",\"answer\":\" \"+str(i+1+n)})\n    for i in range(12):\n        seq=[M[(i-j)%12] for j in range(3)]\n        items.append({\"prompt\":\"Counting backwards: \"+\", \".join(seq)+\",\",\"answer\":\" \"+M[(i-3)%12]})\n        control.append({\"prompt\":\"Counting backwards: \"+\", \".join(str(40+i-j) for j in range(3))+\",\",\"answer\":\" \"+str(40+i-3)})\njson.dump({\"items\":items,\"control\":control},open(\"/work/skill.json\",\"w\"))\n",
