{
 "name": "month_offset",
 "description": "Compute the month reached by moving forward or backward from a named month; matched controls read the offset numeral from the same calendar sentence.",
 "hash": "9d8f768c20d2aff4",
 "agent_items": false,
 "generator_code": "import random,json\nrandom.seed(0)\nmonths='January February March April May June July August September October November December'.split()\nitems=[];control=[]\nfor i in range(96):\n m=random.randrange(12);n=random.randrange(1,12);sgn=random.choice([-1,1]);direction='after' if sgn==1 else 'before'\n sentence=f'Consider {n} months {direction} {months[m]}.'\n items.append({'prompt':sentence+' What month is that? Answer with the month name only:', 'answer':' '+months[(m+sgn*n)%12]})\n control.append({'prompt':sentence+' How many months is the offset? Answer with the numeral only:', 'answer':' '+str(n)})\njson.dump({'items':items,'control':control},open('/work/skill.json','w'))",
