 "agent_items": false,
 "generator_code": "import random,json\nrandom.seed(0)\nirregular=dict(zip('child man woman mouse goose tooth foot person ox louse sheep deer fish'.split(),'children men women mice geese teeth feet people oxen lice sheep deer fish'.split()))\nregular='cat dog book chair table car tree bird flower house apple orange horse cow pig monkey rabbit lion tiger bear duck goat pen cup desk road room door window box fox church brush dish bus class match watch baby city story party lady family country boy toy key day tray wolf leaf knife wife life shelf thief loaf'.split()\ndef plural(w):\n if w in irregular:return irregular[w]\n if w.endswith('fe'):return w[:-2]+'ves'\n if w.endswith('f'):return w[:-1]+'ves'\n if w.endswith('y') and w[-2] not in 'aeiou':return w[:-1]+'ies'\n if w.endswith(('s','x','ch','sh')):return w+'es'\n return w+'s'\nwords=list(irregular)+regular;items=[];control=[]\nfor i in range(120):\n w=words[i%len(words)]\n p=random.choice(['Singular noun: {w}\\nPlural noun:','Give the plural of \"{w}\".\\nAnswer:','English noun: {w}\\nIts plural form is:']).format(w=w)\n items.append({'prompt':p,'answer':' '+plural(w)})\n control.append({'prompt':p.replace('Plural noun:','Copy singular noun:').replace('plural of','singular of').replace('plural form','singular form'),'answer':' '+w})\njson.dump({'items':items,'control':control},open('/work/skill.json','w'))",
