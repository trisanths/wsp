{
 "name": "product_sign",
 "description": "Determine positive or negative sign of a product of signed integers; control asks sign of explicitly identified first factor using the identical expression.",
 "hash": "dfed1b2c89ff5be4",
 "agent_items": false,
 "generator_code": "import random,json,math\nrandom.seed(0)\nitems=[];control=[]\nfor i in range(120):\n vals=[random.choice([-1,1])*random.randint(1,9) for _ in range(random.randint(2,5))]\n expr=' * '.join('('+('+' if v>0 else '-')+str(abs(v))+')' for v in vals)\n common='Expression: '+expr+'\\n'\n items.append({'prompt':common+'Is the product positive or negative?\\nAnswer:','answer':' '+('positive' if math.prod(vals)>0 else 'negative')})\n control.append({'prompt':common+'Is the first factor positive or negative?\\nAnswer:','answer':' '+('positive' if vals[0]>0 else 'negative')})\njson.dump({'items':items,'control':control},open('/work/skill.json','w'))",
