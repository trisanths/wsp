{
 "name": "month_offset",
 "description": "Month-name completion after a cyclic calendar offset; matched control reads the numeric offset from the same sentence.",
 "hash": "40a80738ba3a813f",
 "agent_items": false,
 "generator_code": "import random,json\nrandom.seed(0)\nmonths='January February March April May June July August September October November December'.split()\nitems=[]; controls=[]\nfor i in range(96):\n m=random.randrange(12); n=random.randrange(1,25)\n stem=f'The starting month is {months[m]}. Move forward {n} months. '\n items.append({'prompt':stem+'The resulting month is','answer':' '+months[(m+n)%12]})\n controls.append({'prompt':stem+'The number of months to move forward is','answer':' '+str(n)})\njson.dump({'items':items,'control':controls},open('/work/skill.json','w'))",
