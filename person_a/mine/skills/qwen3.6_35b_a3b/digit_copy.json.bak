{
 "name": "digit_copy",
 "description": "Copy the digit string assigned to a named field, distinguishing distractors; matched control copies a word field in the same format.",
 "hash": "eb65ca89d3fb0ba8",
 "agent_items": false,
 "generator_code": "import random,json\nrandom.seed(0)\nitems=[]; control=[]\nwords=['red','blue','green','gold','white','black','pink','gray']\nfor i in range(100):\n    keys=random.sample(['alpha','beta','gamma','delta'],3)\n    nums=[''.join(str(random.randrange(10)) for _ in range(random.randrange(3,7))) for j in keys]\n    ws=random.sample(words,3); q=random.randrange(3)\n    text='; '.join(k+'='+n+', color='+w for k,n,w in zip(keys,nums,ws))\n    items.append({'prompt':'Record: '+text+'.\\nCopy only the digits for '+keys[q]+':','answer':' '+nums[q]})\n    control.append({'prompt':'Record: '+text+'.\\nCopy only the color for '+keys[q]+':','answer':' '+ws[q]})\njson.dump({'items':items,'control':control},open('/work/skill.json','w'))",
