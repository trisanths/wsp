{"tool": "run_python", "args": {"code": "import json,torch\nL=W('lm_head.weight'); nw=W('model.language_model.norm.weight')\ndef ids(ws):\n    out=[]\n    for w in ws:\n        e=encode(' '+w)\n        if len(e)>=1: out.append(e[0])\n    return sorted(set(out))\ncats={\n'country':['France','Germany','Japan','China','Italy','Spain','Russia','Brazil','Canada','India','Egypt','Mexico','Australia','Argentina','Kenya','Turkey','Greece','Sweden','Norway','Poland','Portugal','Peru','Chile','Iran','Iraq','Thailand','Vietnam','Korea','Nigeria','Morocco','Ireland','Austria','Belgium','Netherlands','Switzerland','Denmark','Finland','Hungary','Indonesia','Pakistan'],\n'month':['January','February','March','April','May','June','July','August','September','October','November','December'],\n'weekday':['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],\n'color':['red','blue','green','yellow','black','white','orange','purple','pink','brown','gray'],\n'ordinal':['first','second','third','fourth','fifth','sixth','seventh','eighth','ninth','tenth'],\n'greek':['alpha','beta','gamma','delta','epsilon','zeta','eta','theta','iota','kappa','lambda'],\n'roman':['I','II','III','IV','V','VI','VII','VIII','IX','X','XI'],\n'digit':[str(i) for i in range(10)],\n}\nU={}\nfor c,ws in cats.items():\n    i=ids(ws); M=L[i]; M=M-L.mean(0)\n    Uc,S,V=torch.linalg.svd(M,full_matrices=False); k=min(8,len(i)); U[c]=V[:k]  # k x d\n    print(c,len(i))\nres={}\nfor layer in [18,20,22,24,25,26,27,28,29,30]:\n    D=W(f'model.language_model.layers.{layer}.mlp.down_proj.weight')  # d x 12288\n    Dn=(D*nw[:,None]); Dn=Dn/Dn.norm(dim=0,keepdim=True)\n    fr={c:(U[c]@Dn).pow(2).sum(0) for c in U}\n    sc=fr['country']-1.5*torch.stack([fr[c] for c in fr if c!='country']).max(0).values\n    top=sc.argsort(descending=True)\n    res[layer]=top[:1024].tolist()\n    print(layer, 'top country frac', fr['country'][top[:64]].mean().item(), 'rand',fr['country'].mean().item())\n    for K in [64,256,512]:\n        json.dump({'kind':'mlp_cluster','layer':layer,'indices':top[:K].tolist()},open(f'/work/cty_L{layer}_{K}.json','w'))\n# logit lens top unit at L26\nD=W('model.language_model.layers.26.mlp.down_proj.weight')\nfor u in res[26][:5]:\n    v=(D[:,u]*nw)@L.T\n    print(u,[decode([t]) for t in v.topk(8).indices.tolist()],[decode([t]) for t in (-v).topk(5).indices.tolist()])"}, "result": {"output": "country 40\nmonth 12\nweekday 7\ncolor 11\nordinal 10\ngreek 11\nroman 11\ndigit 1\n18 top country frac 0.006961892358958721 rand 0.0018341694958508015\n20 top country frac 0.008215325884521008 rand 0.0018234890885651112\n22 top country frac 0.015511342324316502 rand 0.0017400295473635197\n24 top country frac 0.020099006593227386 rand 0.001985448645427823\n25 top country frac 0.015859566628932953 rand 0.001972480909898877\n26 top country frac 0.014132117852568626 rand 0.0019562069792300463\n27 top country frac 0.012040668167173862 rand 0.0019321129657328129\n28 top country frac 0.010245908051729202 rand 0.0018414926016703248\n29 top country frac 0.018239974975585938 rand 0.001876821625046432\n30 top country frac 0.04078849032521248 rand 0.0019337033154442906\n10944 [['lios'], ['\u0120Feinstein'], ['\u00e6\u0143\u00a6\u00e6\u013a\u012e'], ['\u00e5\u0129\u0128'], ['\u00e8\u00b1\u0128'], ['\u00e7\u0133\u00b6'], ['\u00e7\u00bb\u00a5'], ['antai']] [['\u00e8\u012f\u00b7\u00e5\u0127\u00b0'], ['\u0120Dutch'], ['\u0120Holland'], ['\u00e8\u012f\u00b7'], ['\u00e8\u012f\u00b7\u00e8\u013a\u0143']]\n2523 [['uttle'], ['\u00e6\u013a\u00a5\u00e7\u00a7\u012d'], ['ebro'], ['\u00e5\u00ab\u0124'], ['vida'], ['uron'], ['\u00e8\u0139\u00a4'], ['\u00e8\u00a5\u00bf\u00e5\u00b1\u00b1']] [['\u0120ir'], ['Ir'], ['\u0120Ir'], ['\u00e7\u012a\u00b1\u00e5\u00b0\u0136\u00e5\u0127\u00b0'], ['\u0120\u00d0\u013a\u00d1\u0122']]\n4072 [['\u0120eg'], ['\u00e5\u0141\u0125\u00e5\u0131\u012c'], ['\u0120Egyptian'], ['\u0120Egypt'], ['\u0120Eg'], ['Egypt'], ['\u0120Egyptians'], ['eg']] [['estes'], ['\u00e9\u00b